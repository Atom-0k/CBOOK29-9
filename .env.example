# ============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — NO USAR VALORES REALES AQUÍ.
# Copiá este archivo a `.env` y completalo con tus valores reales.
# El archivo `.env` NO debe subirse a Git.
# ============================================================================

# --- Django ---------------------------------------------------------------
# Clave secreta de firma. OBLIGATORIA en producción (si falta, el arranque
# falla). Generar con:
#   python -c "import secrets; print(secrets.token_hex(64))"
DJANGO_SECRET_KEY=REEMPLAZAR_POR_CLAVE_ALEATORIA_DE_64_BYTES_HEX
# False en producción. Con DEBUG=False se exige HTTPS=True y SECRET_KEY.
DJANGO_DEBUG=True
# Hosts permitidos separados por coma. Ej producción: midominio.edu.ar,www.midominio.edu.ar
# En producción no puede estar vacío ni contener '*'.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- HTTPS (producción) ---------------------------------------------------
# Poner True SOLO cuando se sirva por HTTPS (reverse proxy). Es OBLIGATORIO
# con DJANGO_DEBUG=False.
HTTPS=False
SECURE_SSL_REDIRECT=False
# Duración HSTS en segundos. 31536000 = 1 año (producción HTTPS).
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# Marca para precarga de HSTS en navegadores (solo tras HSTS estable).
SECURE_HSTS_PRELOAD=False
# CSP opcional. Solo activarla tras verificar que la app funciona (React,
# login). Ejemplo recomendado (assets locales, sin CDNs):
# SECURE_CSP=default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'
SECURE_CSP=

# --- Sesiones --------------------------------------------------------------
# Segundos de vida de la cookie de sesión.
#
# La sesión se guarda DENTRO de la cookie (SESSION_ENGINE=signed_cookies), así
# que este valor tiene que ser holgado: con SESSION_SAVE_EVERY_REQUEST=True la
# cookie se renueva en cada request, pero el navegador igual la descarta a los
# SESSION_COOKIE_AGE segundos. Si lo dejás corto (1800 = 30 min) la app
# "se cae" a mitad de trabajo aunque la persona siga cliqueando.
# 28800 = 8 h. El corte real por inactividad lo aplica SesionExpiraMiddleware
# con duracion_sesion_min de la configuración institucional.
SESSION_COOKIE_AGE=28800

# --- MongoDB ---------------------------------------------------------------
# La aplicación usa un USUARIO DEDICADO de mínimo privilegio (lectura y
# escritura SOLO sobre MONGO_DB_NAME). NUNCA se usa root/admin desde Django.
#
# Creación del usuario en el servidor (una sola vez, a mano por un admin):
#   use cuaderno_db
#   db.createUser({
#     user: "cuaderno_app",
#     pwd: passwordPrompt(),
#     roles: [{ role: "readWrite", db: "cuaderno_db" }]
#   })
#
# Opción A: URI completa (prioridad sobre las partes). Si usás esta forma,
# incluí tls=true cuando corresponda:
# MONGO_URI=mongodb://cuaderno_app:PASS@host:27017/?authSource=cuaderno_db&tls=true&tlsCAFile=C%3A%2Fcert%2Fca.pem
# Opción B: partes:
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# TLS (obligatorio en producción con DJANGO_DEBUG=False):
MONGO_TLS=False
# Ruta al certificado del server (CA). Si no se define, el cert se valida
# contra los CAs del sistema. No se aceptan certs inseguros en producción.
MONGO_TLS_CAFILE=
# Certificado+clave del cliente (mutual TLS, opcional):
MONGO_TLS_CERT_KEY_FILE=
# MONGO_TLS_ALLOW_INSECURE=True desactivaría la verificación: PROHIBIDO en
# producción (el arranque falla). Solo para labs locales.
MONGO_TLS_ALLOW_INSECURE=False
MONGO_DB_NAME=cuaderno_db
MONGO_TIMEOUT_MS=5000

# --- Rotación de PINs (scripts/rotar_pins.py) -------------------------------
# Directorio FUERA del repositorio donde se escribe el listado de PINs
# nuevos para entregar a la institución. Si no se define, se usa un directorio
# hermano fuera del repo (nunca dentro del repo).
# PIN_OUTPUT_DIR=C:/ruta/fuera/del/repo/cuaderno-pins

# --- Reset de contraseña admin (reset_admin_password.py) --------------------
# Opcional: si no se pasa --password, el script la pide interactivamente o
# la lee de ADMIN_PASSWORD. Nunca debe escribirse en el código ni en logs.
# ADMIN_PASSWORD=

# --- Backups / logs (fuera del repo) ---------------------------------------
BACKUP_DIR=C:/ruta/fuera/del/repo/cuaderno-backups
LOG_DIR=C:/ruta/fuera/del/repo/cuaderno-logs

# Clave de cifrado de backups (Fernet). Generar con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si no se define, los backups se guardan sin cifrar (menos seguro).
BACKUP_ENCRYPTION_KEY=

# --- Avisos de inasistencia por correo --------------------------------------
# Los avisos se ENCOLAN al tomar la lista y se envían con el comando:
#   python manage.py enviar_notificaciones
#
# Además del interruptor de la base (Admin -> Configuracion ->
# notificaciones_email), hace falta que el envío esté configurado acá.
#
# Valor por defecto: se imprime el correo en la consola del comando.
# Para enviar de verdad con Gmail, poner EMAIL_BACKEND=smtp y usar una
# CONTRASENA DE APLICACION de Google (la contraseña de la cuenta no sirve).
#
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=cuaderno@tuinstituto.edu.ar
# EMAIL_HOST_PASSWORD=clave-de-aplicacion-aqui
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_DEFAULT_FROM_EMAIL=cuaderno@tuinstituto.edu.ar
